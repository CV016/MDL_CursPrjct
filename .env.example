# =============================================================================
# AI-DOC INTERACT — example environment file
# Copy this to .env and fill in real values before running docker-compose.
# Never commit the real .env file to version control.
# =============================================================================

# PostgreSQL
POSTGRES_USER=aidoc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aidoc

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# A/B routing: percentage (0-100) of inference requests routed to variant B
AB_VARIANT_B_PERCENT=20

# HuggingFace model identifiers for inference workers
SUMMARIZER_MODEL=facebook/bart-large-cnn
QGEN_MODEL=valhalla/t5-base-qg-hl
