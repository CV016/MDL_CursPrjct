# =============================================================================
# AI-DOC INTERACT — example environment file
#
# Copy this file to .env before running docker-compose:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# The .env file is read automatically by docker-compose.
# NEVER commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# MLflow experiment name — appears as the experiment label in the MLflow UI
# ---------------------------------------------------------------------------
MLFLOW_EXPERIMENT_NAME=ai_doc_interact

# ---------------------------------------------------------------------------
# HuggingFace model identifiers
# Changing these will cause the backend to download different model weights
# on the next container startup.
# ---------------------------------------------------------------------------
MODEL_BART=facebook/bart-large-cnn
MODEL_FLAN=google/flan-t5-base

# ---------------------------------------------------------------------------
# Mock JWT token — shared secret between frontend-ui and backend-api.
# Change this to any long random string in a real deployment.
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
MOCK_JWT_TOKEN=mock-jwt-token-for-academic-project

# ---------------------------------------------------------------------------
# Thompson Sampling A/B router — no tunable parameter needed.
# Exploration and exploitation are balanced automatically by the Beta
# posterior. No environment variable is required.
# ---------------------------------------------------------------------------
